<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Shackles</AssemblyName>
    <RootNamespace>Shackles.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shackles.AppContainers\Shackles.AppContainers.csproj" />
    <ProjectReference Include="..\Shackles.ExperimentalSandboxes\Shackles.ExperimentalSandboxes.csproj" />
    <ProjectReference Include="..\Shackles.JobObjects\Shackles.JobObjects.csproj" />
  </ItemGroup>
</Project>
