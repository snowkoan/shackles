<Window x:Class="Shackles.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Shackles.App.Views"
        Title="Shackles"
        Width="1420"
        Height="900"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="18,12"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Margin="24,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,9,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionStyle}"
                               Text="Workspace" />
                    <Border Padding="3"
                            Background="{DynamicResource MutedPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="JobObjectsWorkspaceTab"
                                         GroupName="Workspace"
                                         IsChecked="True"
                                         Style="{StaticResource WorkspaceTabStyle}"
                                         Checked="JobObjectsWorkspaceTab_Click"
                                         Content="_Job Objects"
                                         AutomationProperties.Name="Show Job Objects workspace" />
                            <RadioButton x:Name="AppContainerWorkspaceTab"
                                         GroupName="Workspace"
                                         Style="{StaticResource WorkspaceTabStyle}"
                                         Checked="AppContainerWorkspaceTab_Click"
                                         Content="_AppContainer"
                                         AutomationProperties.Name="Show AppContainer workspace" />
                            <RadioButton x:Name="ExperimentalSandboxWorkspaceTab"
                                         GroupName="Workspace"
                                         Style="{StaticResource WorkspaceTabStyle}"
                                         Checked="ExperimentalSandboxWorkspaceTab_Click"
                                         Content="_Experimental Sandbox"
                                         AutomationProperties.Name="Show experimental process sandbox workspace" />
                            <RadioButton x:Name="WespWorkspaceTab"
                                         GroupName="Workspace"
                                         Style="{StaticResource WorkspaceTabStyle}"
                                         Checked="WespWorkspaceTab_Click"
                                         Content="_WESP Blocking"
                                         AutomationProperties.Name="Show WESP Blocking workspace" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="21" FontWeight="SemiBold" Text="Shackles" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Windows process restriction control center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                MinHeight="34"
                Padding="14,7"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid Margin="14">
            <Grid x:Name="JobObjectsWorkspace">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MaxHeight="190" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="14,12"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        AutomationProperties.Name="Job Objects workspace">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Job Objects" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="Only Job Objects created or explicitly opened here are shown; Windows does not support arbitrary system Job Object enumeration." />
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                            <Button Margin="0,0,8,0" Click="NewJob_Click" Content="_New Job Object" />
                            <Button Margin="0,0,8,0" Click="OpenJob_Click" Content="_Open named Job Object" />
                            <Button Margin="0,0,8,0"
                                    IsEnabled="{Binding HasSelectedJob}"
                                    Click="AssignRunningProcesses_Click"
                                    Content="_Assign running processes…"
                                    AutomationProperties.Name="Assign running processes to selected Job Object" />
                            <Button Click="LaunchProcess_Click" Content="_Launch in Job Object…" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <ListBox x:Name="JobList"
                         Grid.Row="1"
                         Margin="0,10,0,0"
                         ItemsSource="{Binding Jobs}"
                         SelectedItem="{Binding SelectedJob}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Background="Transparent"
                         AutomationProperties.Name="Job Objects opened in this session">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,10,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="250"
                                    MinHeight="112"
                                    Style="{StaticResource CardBorderStyle}"
                                    AutomationProperties.Name="{Binding DisplayName}"
                                    AutomationProperties.HelpText="Select this Job Object to view and manage it.">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource BadgeStyle}">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding OriginBadge}" />
                                        </Border>
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Margin="0,5,0,0" Text="{Binding MemberCountDisplay}" />
                                    <TextBlock Grid.Row="2"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="{Binding RestrictionSummary}" />
                                    <TextBlock Grid.Row="3"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               Text="Select to manage" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedJob}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel MaxWidth="470"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextBlock.TextAlignment="Center">
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Create or open a Job Object" />
                                <TextBlock Margin="0,8,0,16"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="Create or open a Job Object, then configure its restrictions, launch a process, or assign running processes." />
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Click="NewJob_Click" Content="_New Job Object" />
                                    <Button Click="OpenJob_Click" Content="_Open named Job Object" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <views:JobDetailsView DataContext="{Binding SelectedJob}"
                                              AssignProcessesRequested="JobDetails_AssignProcessesRequested"
                                              LaunchRequested="JobDetails_LaunchRequested"
                                              CloseRequested="JobDetails_CloseRequested">
                            <views:JobDetailsView.Style>
                                <Style TargetType="{x:Type views:JobDetailsView}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.HasSelectedJob, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:JobDetailsView.Style>
                        </views:JobDetailsView>
                    </Grid>
                </Border>
            </Grid>
            </Grid>

            <views:AppContainerWorkspaceView x:Name="AppContainerWorkspace"
                                             Visibility="Collapsed" />
            <views:ExperimentalSandboxWorkspaceView x:Name="ExperimentalSandboxWorkspace"
                                                    Visibility="Collapsed" />
            <views:WespWorkspaceView x:Name="WespWorkspace"
                                     Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
