<Window x:Class="Shackles.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Shackles.App.Views"
        xmlns:controls="clr-namespace:Shackles.App.Controls"
        xmlns:infrastructure="clr-namespace:Shackles.App.Infrastructure"
        Title="Shackles"
        Width="1420"
        Height="900"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <infrastructure:JobWorkspaceMinimumHeightConverter x:Key="JobWorkspaceMinimumHeightConverter" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="18,12"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Margin="24,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,9,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionStyle}"
                               Text="Workspace" />
                    <Border Padding="3"
                            Background="{DynamicResource MutedPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="JobObjectsWorkspaceTab"
                                         GroupName="Workspace"
                                         IsChecked="True"
                                         Style="{StaticResource WorkspaceTabStyle}"
                                         Checked="JobObjectsWorkspaceTab_Click"
                                         Content="_Job Objects"
                                         AutomationProperties.Name="Show Job Objects workspace" />
                            <RadioButton x:Name="AppContainerWorkspaceTab"
                                         GroupName="Workspace"
                                         Style="{StaticResource WorkspaceTabStyle}"
                                         Checked="AppContainerWorkspaceTab_Click"
                                         Content="_AppContainer"
                                         AutomationProperties.Name="Show AppContainer workspace" />
                            <RadioButton x:Name="ExperimentalSandboxWorkspaceTab"
                                         GroupName="Workspace"
                                         Style="{StaticResource WorkspaceTabStyle}"
                                         Checked="ExperimentalSandboxWorkspaceTab_Click"
                                         Content="_Experimental Sandbox"
                                         AutomationProperties.Name="Show experimental process sandbox workspace" />
                            <RadioButton x:Name="WespWorkspaceTab"
                                         GroupName="Workspace"
                                         Style="{StaticResource WorkspaceTabStyle}"
                                         Checked="WespWorkspaceTab_Click"
                                         Content="_WESP Blocking"
                                         AutomationProperties.Name="Show WESP Blocking workspace" />
                            <RadioButton x:Name="WfpWorkspaceTab"
                                         GroupName="Workspace"
                                         Style="{StaticResource WorkspaceTabStyle}"
                                         Checked="WfpWorkspaceTab_Click"
                                         Content="W_FP Blocking"
                                         AutomationProperties.Name="Show WFP Blocking workspace" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Text="Shackles" />
                        <Border x:Name="ElevationBadge"
                                Padding="9,5"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentTextBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="20" Height="23"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center">
                                    <Path Data="M 12,1 L 21,4 L 21,10 C 21,16 17,21 12,24 C 7,21 3,16 3,10 L 3,4 Z M 12,1 L 12,24 M 3,10 L 21,10"
                                          Stroke="{DynamicResource AccentTextBrush}"
                                          StrokeThickness="1.8"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                                <TextBlock x:Name="ElevationBadgeText"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontWeight="SemiBold"
                                           Text="Administrator" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Windows process restriction control center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                MinHeight="34"
                Padding="14,7"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBox Text="{Binding StatusMessage, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                     AutomationProperties.Name="Workspace operation result"
                     AutomationProperties.LiveSetting="Polite">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <Grid Margin="14">
            <Grid x:Name="JobObjectsWorkspace">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Job Objects workspace content">
            <!-- Expand with wrapped chrome while retaining a usable settings viewport. -->
            <Grid Height="{Binding ActualHeight, ElementName=JobObjectsWorkspace}">
                <Grid.MinHeight>
                    <MultiBinding Converter="{StaticResource JobWorkspaceMinimumHeightConverter}">
                        <Binding ElementName="JobWorkspaceHeader" Path="ActualHeight" />
                        <Binding ElementName="JobList" Path="ActualHeight" />
                        <Binding ElementName="SelectedJobDetails" Path="MinHeight" />
                        <Binding ElementName="SelectedJobDetails" Path="Visibility" />
                    </MultiBinding>
                </Grid.MinHeight>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="JobWorkspaceHeader" Style="{StaticResource WorkspaceHeaderStyle}"
                        AutomationProperties.Name="Job Objects workspace">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Job Objects" />
                        <Button Grid.Column="1" Margin="20,0,0,0" Style="{StaticResource CompactButtonStyle}"
                                Click="OpenJob_Click" Content="_Open named Job Object" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="Only Job Objects created or explicitly opened here are shown; Windows does not support arbitrary system Job Object enumeration." />
                    </Grid>
                </Border>

                <controls:InstanceTabStrip x:Name="JobList"
                                          Grid.Row="1"
                                          Margin="0,10,0,0"
                                          ItemsSource="{Binding Jobs}"
                                          SelectedItem="{Binding SelectedJob}"
                                          CloseEnabledMemberPath="CanOperate"
                                          NewToolTip="Create a new Job Object"
                                          NewRequested="NewJob_Click"
                                          CloseRequested="JobTab_CloseRequested"
                                          AutomationProperties.Name="Job Object tabs">
                    <controls:InstanceTabStrip.ItemTemplate>
                        <DataTemplate>
                            <controls:InstanceTabHeader Text="{Binding DisplayName}"
                                                        Status="{Binding OriginBadge}"
                                                        Detail="{Binding MemberCountDisplay}"
                                                        ToolTip="{Binding RestrictionSummary}" />
                        </DataTemplate>
                    </controls:InstanceTabStrip.ItemTemplate>
                </controls:InstanceTabStrip>

                <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedJob}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel MaxWidth="470"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextBlock.TextAlignment="Center">
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Create or open a Job Object" />
                                <TextBlock Margin="0,8,0,16"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="Create or open a Job Object, then configure its restrictions, launch a process, or assign running processes." />
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"
                                            Click="NewJob_Click" Content="_New Job Object" />
                                    <Button Style="{StaticResource ActionButtonStyle}"
                                            Click="OpenJob_Click" Content="_Open named Job Object" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <views:JobDetailsView x:Name="SelectedJobDetails"
                                              DataContext="{Binding SelectedJob}"
                                              AssignProcessesRequested="AssignRunningProcesses_Click"
                                              LaunchRequested="JobDetails_LaunchRequested"
                                              CloseRequested="JobDetails_CloseRequested">
                            <views:JobDetailsView.Style>
                                <Style TargetType="{x:Type views:JobDetailsView}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.HasSelectedJob, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:JobDetailsView.Style>
                        </views:JobDetailsView>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>
            </Grid>

            <views:AppContainerWorkspaceView x:Name="AppContainerWorkspace"
                                             Visibility="Collapsed" />
            <views:ExperimentalSandboxWorkspaceView x:Name="ExperimentalSandboxWorkspace"
                                                    Visibility="Collapsed" />
            <views:WespWorkspaceView x:Name="WespWorkspace"
                                     Visibility="Collapsed" />
            <views:WfpWorkspaceView x:Name="WfpWorkspace"
                                    Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
