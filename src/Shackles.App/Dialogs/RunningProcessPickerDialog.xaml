<Window x:Class="Shackles.App.Dialogs.RunningProcessPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose running processes"
        Width="860"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="Choose running processes" />
        <TextBlock x:Name="DescriptionText"
                   Grid.Row="1"
                   Margin="0,5,0,14"
                   Style="{StaticResource CaptionStyle}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,9,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="Search" />
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Search by name, PID, or executable path"
                     AutomationProperties.Name="Search running processes"
                     AutomationProperties.HelpText="Filter by process name, PID, or executable path" />
            <Button x:Name="RefreshButton"
                    Grid.Column="2"
                    Margin="9,0,0,0"
                    Padding="10,5"
                    Click="RefreshButton_Click"
                    Content="_Refresh"
                    AutomationProperties.Name="Refresh running processes" />
        </Grid>

        <ListView x:Name="ProcessList"
                  Grid.Row="3"
                  ItemsSource="{Binding}"
                  SelectionMode="Extended"
                  SelectionChanged="ProcessList_SelectionChanged"
                  BorderThickness="1"
                  ToolTip="Use Ctrl or Shift to select more than one process"
                  AutomationProperties.Name="Eligible running processes">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Width="180" Header="Name" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Width="72" Header="PID" DisplayMemberBinding="{Binding ProcessId}" />
                    <GridViewColumn Width="92" Header="Memory" DisplayMemberBinding="{Binding WorkingSetDisplay}" />
                    <GridViewColumn Width="72" Header="Session" DisplayMemberBinding="{Binding SessionId}" />
                    <GridViewColumn Width="370" Header="Executable path" DisplayMemberBinding="{Binding ImagePath}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProcessCountText"
                           Style="{StaticResource CaptionStyle}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="SelectionCountText"
                           Margin="0,2,0,0"
                           FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Polite"
                           Text="No processes selected" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button MinWidth="86"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        IsCancel="True"
                        Content="Cancel" />
                <Button x:Name="SelectButton"
                        MinWidth="126"
                        Padding="10,6"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="SelectButton_Click"
                        Content="_Select" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
