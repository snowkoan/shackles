<Window x:Class="Shackles.App.Dialogs.AssignmentResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assignment results"
        Width="780"
        Height="430"
        MinWidth="620"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SectionTitleStyle}"
                   Text="Process assignment results" />
        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Margin="0,6,0,12"
                   Style="{StaticResource CaptionStyle}"
                   AutomationProperties.LiveSetting="Polite" />

        <ListView x:Name="ResultsList"
                  Grid.Row="2"
                  AutomationProperties.Name="Per-process assignment results">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="150" Header="Process" DisplayMemberBinding="{Binding ProcessName}" />
                    <GridViewColumn Width="70" Header="PID" DisplayMemberBinding="{Binding ProcessId}" />
                    <GridViewColumn Width="100" Header="Status" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Width="390" Header="Details">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="4,3"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding Message}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Button Grid.Row="3"
                Margin="0,16,0,0"
                MinWidth="90"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Content="_Close" />
    </Grid>
</Window>
