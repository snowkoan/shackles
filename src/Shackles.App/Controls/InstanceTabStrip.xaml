<ListBox x:Class="Shackles.App.Controls.InstanceTabStrip"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="clr-namespace:Shackles.App.Controls"
         BorderThickness="0" Background="Transparent"
         SelectionMode="Single"
         HorizontalContentAlignment="Stretch"
         KeyboardNavigation.TabNavigation="Continue"
         KeyboardNavigation.DirectionalNavigation="Contained">
    <ListBox.Resources>
        <BooleanToVisibilityConverter x:Key="TabOverflowVisibilityConverter" />
        <controls:InstanceTabNewButtonMarginConverter x:Key="TabNewButtonMarginConverter" />
        <Style x:Key="TabActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionChrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionChrome" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ActionChrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ListBox.Resources>
    <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MaxWidth" Value="230" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="10,5,4,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TabChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource MutedPanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="0,0,4,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Button x:Name="PART_CloseButton" Grid.Column="1"
                                        Style="{StaticResource TabActionButtonStyle}"
                                        Focusable="False"
                                        FontSize="18" Content="×"
                                        Click="CloseButton_Click"
                                        IsEnabled="{Binding (controls:InstanceTabStrip.IsCloseEnabled), RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTip="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, StringFormat=Close {0}}"
                                        AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, StringFormat=Close {0}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource PanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="IsTabStop" Value="True" />
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource PanelBrush}" />
                                <Setter TargetName="TabChrome" Property="BorderThickness" Value="1,1,1,0" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.Template>
        <ControlTemplate TargetType="{x:Type controls:InstanceTabStrip}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PART_ScrollLeftButton" Width="28" Margin="0,0,4,0"
                        Style="{StaticResource TabActionButtonStyle}" FontSize="22" Content="‹"
                        Click="ScrollLeftButton_Click" Focusable="False"
                        IsEnabled="{Binding CanScrollLeft, RelativeSource={RelativeSource TemplatedParent}}"
                        Visibility="{Binding HasOverflow, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TabOverflowVisibilityConverter}}"
                        ToolTip="Scroll tabs left" AutomationProperties.Name="Scroll instance tabs left" />
                <ScrollViewer x:Name="PART_TabScroller" Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False" Focusable="False">
                    <ItemsPresenter />
                </ScrollViewer>
                <Button x:Name="PART_ScrollRightButton" Grid.Column="2" Width="28" Margin="4,0,0,0"
                        Style="{StaticResource TabActionButtonStyle}" FontSize="22" Content="›"
                        Click="ScrollRightButton_Click" Focusable="False"
                        IsEnabled="{Binding CanScrollRight, RelativeSource={RelativeSource TemplatedParent}}"
                        Visibility="{Binding HasOverflow, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TabOverflowVisibilityConverter}}"
                        ToolTip="Scroll tabs right" AutomationProperties.Name="Scroll instance tabs right" />
                <Button x:Name="PART_NewButton" Width="32" FontSize="21" Content="+"
                        Click="NewButton_Click"
                        IsEnabled="{Binding IsNewEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                        ToolTip="{Binding NewToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                        AutomationProperties.Name="Create a new instance">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabActionButtonStyle}">
                            <Setter Property="Grid.Column" Value="3" />
                            <Setter Property="Margin" Value="5,0,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOverflow, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="Margin" Value="{Binding ExtentWidth, ElementName=PART_TabScroller, Converter={StaticResource TabNewButtonMarginConverter}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </ControlTemplate>
    </ListBox.Template>
</ListBox>
