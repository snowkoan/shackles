<UserControl x:Class="Shackles.App.Views.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Margin="0,0,0,14"
                    Padding="11"
                    CornerRadius="6"
                    Background="{DynamicResource MutedPanelBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource BadgeStyle}">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="{Binding Capabilities.CpuRateControl.BadgeText}" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="CPU rate control" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="{Binding Capabilities.CpuRateControl.Reason}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Margin="0,0,0,14"
                    Padding="11"
                    CornerRadius="6"
                    Background="{DynamicResource MutedPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding Editor.UsesUnsupportedPerProcessorCaps, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="Read-only per-processor CPU caps mode">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Per-processor caps (Windows SDK mode; editing unsupported)" />
                    <TextBlock Margin="0,3,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="This job uses the SDK CPU flag 0x20. Shackles preserves the existing setting during unrelated Apply operations, but does not expose controls that could alter it." />
                </StackPanel>
            </Border>

            <GroupBox Header="Control mode"
                      Style="{StaticResource EditorGroupStyle}"
                      IsEnabled="{Binding Capabilities.CpuRateControl.CanSet}">
                <StackPanel IsEnabled="{Binding Editor.CanEditCpu}">
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="HardCap is an enforced ceiling. Rate, Weight, and MinimumMaximum are scheduling controls whose observed effect depends on system load." />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Mode" />
                        <ComboBox Grid.Column="1"
                                  Margin="5,3"
                                  ItemsSource="{Binding Editor.CpuModes}"
                                  SelectedItem="{Binding Editor.CpuMode}" />

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="Rate / hard cap" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="5,3"
                                 Text="{Binding Editor.CpuRatePercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="percent (Rate or HardCap)" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="Weight" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="5,3"
                                 Text="{Binding Editor.CpuWeight, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="1–9 (Weight mode)" />

                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="Minimum / maximum" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="80"
                                     Margin="5,3"
                                     Text="{Binding Editor.CpuMinimumPercent, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Minimum percent" />
                            <TextBox Width="80"
                                     Margin="5,3"
                                     Text="{Binding Editor.CpuMaximumPercent, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Maximum percent" />
                        </StackPanel>
                        <TextBlock Grid.Row="3"
                                   Grid.Column="2"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="percent (MinimumMaximum mode)" />

                        <CheckBox Grid.Row="4"
                                  Grid.Column="1"
                                  Margin="5,5"
                                  IsChecked="{Binding Editor.CpuNotify}"
                                  Content="Enable CPU rate notifications" />
                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
