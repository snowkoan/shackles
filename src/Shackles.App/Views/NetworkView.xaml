<UserControl x:Class="Shackles.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Margin="0,0,0,14"
                    Padding="11"
                    CornerRadius="6"
                    Background="{DynamicResource MutedPanelBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource BadgeStyle}">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="{Binding Capabilities.NetworkRateControl.BadgeText}" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Outbound network control and DSCP marking" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="{Binding Capabilities.NetworkRateControl.Reason}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <GroupBox Header="Network policy"
                      Style="{StaticResource EditorGroupStyle}"
                      IsEnabled="{Binding Capabilities.NetworkRateControl.CanSet}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox IsChecked="{Binding Editor.NetworkBandwidthEnabled}"
                              Content="Maximum upload speed"
                              ToolTip="Limits outbound traffic from processes in this Job Object." />
                    <TextBox Grid.Column="1"
                             Margin="8,3"
                             IsEnabled="{Binding Editor.NetworkBandwidthEnabled}"
                             AutomationProperties.Name="Maximum upload speed value"
                             AutomationProperties.HelpText="{Binding Editor.NetworkBandwidthHint}"
                             Text="{Binding Editor.NetworkBandwidthValue, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Grid.Column="2"
                          IsEnabled="{Binding Editor.NetworkBandwidthEnabled}">
                        <ComboBox Margin="7,3"
                                  MinWidth="100"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="Maximum upload speed unit"
                                  AutomationProperties.HelpText="{Binding Editor.NetworkBandwidthUnit.Description}"
                                  ItemsSource="{Binding Editor.NetworkBandwidthUnits}"
                                  SelectedItem="{Binding Editor.NetworkBandwidthUnit}"
                                  IsEnabled="{Binding Editor.CanChangeNetworkBandwidthUnit}"
                                  ToolTip="{Binding Editor.NetworkBandwidthUnit.Description}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Symbol}" ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="3"
                               Margin="0,7,0,12"
                               Style="{StaticResource CaptionStyle}"
                               Text="{Binding Editor.NetworkBandwidthHint}" />

                    <CheckBox Grid.Row="2"
                              IsChecked="{Binding Editor.DscpEnabled}"
                              Content="DSCP tag" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Margin="8,3"
                             IsEnabled="{Binding Editor.DscpEnabled}"
                             Text="{Binding Editor.DscpTag, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Margin="7,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionStyle}"
                               Text="0–63; actual packet marking can be affected by network policy" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
