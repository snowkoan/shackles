<UserControl x:Class="Shackles.App.Views.WespWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="952"
             AutomationProperties.Name="WESP Blocking preview workspace">
    <UserControl.Resources>
        <Style x:Key="StepTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,12,9" />
        </Style>
        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0"
                           LastChildFill="False"
                           VerticalAlignment="Center">
                    <Border Margin="0,0,8,0" Style="{StaticResource BadgeStyle}">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Text="PREVIEW / POC" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="WESP Blocking" />
                </DockPanel>

                <TextBlock Grid.Column="2"
                           MaxWidth="720"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionStyle}"
                           Text="Apply targeted file, registry, and child-process blocking to an application you launch or one that is already running. Windows permissions remain unchanged."
                           TextWrapping="Wrap" />

                <Border Grid.Column="4"
                        Padding="9,5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource MutedPanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="RefreshSupportButton"
                                DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                Click="RefreshSupport_Click"
                                Content="Refresh _support" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SupportStateText"
                                       HorizontalAlignment="Right"
                                       FontWeight="SemiBold"
                                       Text="Support not checked" />
                            <TextBlock x:Name="SupportDetailText"
                                       MaxWidth="310"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="Open this workspace or refresh to check WESP on this computer."
                                       TextAlignment="Right"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="InteractiveWorkspace" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" MinHeight="280" />
                <RowDefinition Height="12" />
                <RowDefinition Height="2*" MinHeight="170" MaxHeight="300" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="560" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,15,16,16">
                        <StackPanel x:Name="PolicyEditorPanel">
                            <TextBlock Style="{StaticResource StepTitleStyle}" Text="1  Choose what WESP blocks" />
                            <TextBlock Margin="0,5,0,10"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="Folder and registry rules include the configured path and its descendants. Choose Blocked to deny reads and changes, or Read-only to allow reads while denying changes. Rules are fixed after the session starts."
                                       TextWrapping="Wrap" />

                            <TabControl MinHeight="330">
                                <TabItem Header="Files">
                                    <StackPanel Margin="13">
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   Text="Add an existing folder, then choose how processes using this session and newly tagged descendants may access it. An overlapping blocked folder remains blocked."
                                                   TextWrapping="Wrap" />
                                        <CheckBox x:Name="BlockUncPathsCheckBox"
                                                  Margin="0,12,0,0"
                                                  Click="BlockUncPaths_Click"
                                                  Content="Block access to UNC paths"
                                                  AutomationProperties.Name="Block access to UNC paths" />
                                        <TextBlock Margin="22,3,0,0"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Text="Prevents access to network file paths such as \\server\share."
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,12,0,3"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Text="Existing folder path" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="FileRulePathTextBox"
                                                     AutomationProperties.Name="Folder path for WESP Blocking" />
                                            <Button Grid.Column="1"
                                                    Margin="7,0,0,0"
                                                    Padding="9,5"
                                                    Click="BrowseFileRuleFolder_Click"
                                                    Content="Browse…" />
                                        </Grid>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="FileRuleAccessComboBox"
                                                      SelectedIndex="0"
                                                      AutomationProperties.Name="Folder access">
                                                <ComboBoxItem Content="Blocked" />
                                                <ComboBoxItem Content="Read-only" />
                                            </ComboBox>
                                            <Button Grid.Column="1"
                                                    Margin="7,0,0,0"
                                                    Padding="9,5"
                                                    Click="AddFileRule_Click"
                                                    Content="Add folder" />
                                        </Grid>
                                        <ListBox x:Name="FileRuleList"
                                                 MinHeight="105"
                                                 MaxHeight="210"
                                                 Margin="0,10,0,0"
                                                 BorderThickness="1"
                                                 AutomationProperties.Name="Configured WESP file rules">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="7,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="125" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Text="{Binding Path}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Path}" />
                                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                                       Text="Folder and descendants" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  Margin="8,0"
                                                                  SelectedIndex="{Binding AccessIndex, Mode=TwoWay}"
                                                                  SelectionChanged="ResourceAccess_SelectionChanged">
                                                            <ComboBoxItem Content="Blocked" />
                                                            <ComboBoxItem Content="Read-only" />
                                                        </ComboBox>
                                                        <Button Grid.Column="2"
                                                                Padding="7,4"
                                                                Tag="{Binding}"
                                                                Click="RemoveFileRule_Click"
                                                                Content="Remove" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="Registry">
                                    <StackPanel Margin="13">
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   Text="Add a registry key path and choose whether it is blocked or read-only. The key does not need to exist yet. Use HKCU, HKLM, HKCR, HKU, or a canonical \REGISTRY path."
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,10,0,3"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Text="Registry key path" />
                                        <TextBox x:Name="RegistryRulePathTextBox"
                                                 ToolTip="For example: HKCU\Software\Contoso"
                                                 AutomationProperties.Name="Registry key path for WESP Blocking" />
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="RegistryRuleAccessComboBox"
                                                      SelectedIndex="0"
                                                      AutomationProperties.Name="Registry key access">
                                                <ComboBoxItem Content="Blocked" />
                                                <ComboBoxItem Content="Read-only" />
                                            </ComboBox>
                                            <Button Grid.Column="1"
                                                    Margin="7,0,0,0"
                                                    Padding="9,5"
                                                    Click="AddRegistryRule_Click"
                                                    Content="Add key" />
                                        </Grid>
                                        <ListBox x:Name="RegistryRuleList"
                                                 MinHeight="105"
                                                 MaxHeight="210"
                                                 Margin="0,10,0,0"
                                                 BorderThickness="1"
                                                 AutomationProperties.Name="Configured WESP registry rules">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="7,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="125" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Text="{Binding Path}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Path}" />
                                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                                       Text="Key and descendants" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  Margin="8,0"
                                                                  SelectedIndex="{Binding AccessIndex, Mode=TwoWay}"
                                                                  SelectionChanged="ResourceAccess_SelectionChanged">
                                                            <ComboBoxItem Content="Blocked" />
                                                            <ComboBoxItem Content="Read-only" />
                                                        </ComboBox>
                                                        <Button Grid.Column="2"
                                                                Padding="7,4"
                                                                Tag="{Binding}"
                                                                Click="RemoveRegistryRule_Click"
                                                                Content="Remove" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="Child applications">
                                    <StackPanel Margin="13">
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   Text="Enter an executable name such as powershell.exe; no matching file needs to exist. You can also paste or browse to a full path as a convenience. Matching is case-insensitive but otherwise exact, including the extension: powershell does not match powershell.exe."
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,10,0,3"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Text="Executable name" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BlockedChildExecutableTextBox"
                                                     ToolTip="For example: powershell.exe. A full path is also accepted."
                                                     AutomationProperties.Name="Blocked child application executable name" />
                                            <Button Grid.Column="1"
                                                    Margin="7,0,0,0"
                                                    Padding="9,5"
                                                    Click="BrowseBlockedChildExecutable_Click"
                                                    Content="Browse…" />
                                        </Grid>
                                        <Button Margin="0,7,0,0"
                                                HorizontalAlignment="Right"
                                                Padding="9,5"
                                                Click="AddBlockedChildExecutable_Click"
                                                Content="Add blocked name" />
                                        <ListBox x:Name="BlockedChildExecutableList"
                                                 MinHeight="105"
                                                 MaxHeight="210"
                                                 Margin="0,10,0,0"
                                                 BorderThickness="1"
                                                 AutomationProperties.Name="Blocked child applications">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="7,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Text="{Binding}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding}" />
                                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                                       Text="Exact case-insensitive name match, regardless of folder in this process tree" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Margin="7,0,0,0"
                                                                Padding="7,4"
                                                                Tag="{Binding}"
                                                                Click="RemoveBlockedChildExecutable_Click"
                                                                Content="Remove" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>

                        <Separator Margin="0,16,0,14" />
                        <TextBlock Style="{StaticResource StepTitleStyle}" Text="2  Optional launch settings" />
                        <TextBlock Margin="0,5,0,10"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="Choose a root application if Shackles should launch processes for this session. Leave it blank to start with running processes only. Once the session starts, the root choice stays fixed."
                                   TextWrapping="Wrap" />

                        <StackPanel x:Name="RootExecutablePanel">
                            <TextBlock Margin="0,0,0,3" Style="{StaticResource FieldLabelStyle}" Text="Root application (optional)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RootExecutableTextBox"
                                         TextChanged="RootExecutableText_Changed"
                                         AutomationProperties.Name="Root application path" />
                                <Button Grid.Column="1"
                                        Margin="7,0,0,0"
                                        Padding="9,5"
                                        Click="BrowseRootExecutable_Click"
                                        Content="Browse…" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Margin="0,9,0,3" Style="{StaticResource FieldLabelStyle}" Text="Arguments" />
                        <TextBox x:Name="ArgumentsTextBox" AutomationProperties.Name="Process arguments" />

                        <TextBlock Margin="0,9,0,3" Style="{StaticResource FieldLabelStyle}" Text="Working directory" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WorkingDirectoryTextBox"
                                     AutomationProperties.Name="Process working directory" />
                            <Button x:Name="BrowseWorkingDirectoryButton"
                                    Grid.Column="1"
                                    Margin="7,0,0,0"
                                    Padding="9,5"
                                    Click="BrowseWorkingDirectory_Click"
                                    Content="Browse…" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="Leave blank to use the root application's folder." />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,15,16,10">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource BadgeStyle}">
                                    <TextBlock x:Name="SessionStateBadgeText"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="DRAFT" />
                                </Border>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Blocking session" />
                            </DockPanel>

                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="Root application" />
                                <TextBlock x:Name="RootSummaryText"
                                           Grid.Column="1"
                                           Style="{StaticResource SummaryValueStyle}"
                                           Text="Not selected"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource SummaryLabelStyle}" Text="Files" />
                                <TextBlock x:Name="FileRulesSummaryText"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Style="{StaticResource SummaryValueStyle}"
                                           Text="0 blocked • 0 read-only" />
                                <TextBlock Grid.Row="2" Style="{StaticResource SummaryLabelStyle}" Text="Registry" />
                                <TextBlock x:Name="RegistryRulesSummaryText"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Style="{StaticResource SummaryValueStyle}"
                                           Text="0 blocked • 0 read-only" />
                                <TextBlock Grid.Row="3" Style="{StaticResource SummaryLabelStyle}" Text="Child applications" />
                                <TextBlock x:Name="BlockedChildrenSummaryText"
                                           Grid.Row="3"
                                           Grid.Column="1"
                                           Style="{StaticResource SummaryValueStyle}"
                                           Text="0 blocked" />
                                <TextBlock Grid.Row="4" Style="{StaticResource SummaryLabelStyle}" Text="WESP client" />
                                <TextBlock x:Name="ClientVersionSummaryText"
                                           Grid.Row="4"
                                           Grid.Column="1"
                                           Style="{StaticResource SummaryValueStyle}"
                                           Text="Not connected"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                <TextBlock Grid.Row="5" Style="{StaticResource SummaryLabelStyle}" Text="Session processes" />
                                <TextBlock x:Name="SessionProcessesSummaryText"
                                           Grid.Row="5"
                                           Grid.Column="1"
                                           Style="{StaticResource SummaryValueStyle}"
                                           Text="0" />
                            </Grid>

                            <Separator Margin="0,5,0,12" />
                            <DockPanel>
                                <Button x:Name="RefreshSessionButton"
                                        DockPanel.Dock="Right"
                                        Padding="8,4"
                                        Click="RefreshSession_Click"
                                        Content="Refresh" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="Processes using this session" />
                            </DockPanel>
                            <Button x:Name="ApplyExistingProcessesButton"
                                    Margin="0,7,0,0"
                                    Padding="8,5"
                                    Click="ApplyExistingProcesses_Click"
                                    Content="_Use running processes…"
                                    ToolTip="Start WESP Blocking with one or more processes that are already running"
                                    AutomationProperties.Name="Start or apply WESP Blocking with running processes" />
                            <ListBox x:Name="MemberProcessList"
                                     MinHeight="48"
                                     MaxHeight="105"
                                     Margin="0,8,0,0"
                                     BorderThickness="1"
                                     AutomationProperties.Name="Processes using this WESP Blocking session" />

                            <Border x:Name="WorkspaceNotice"
                                    Margin="0,14,0,0"
                                    Padding="9"
                                    Background="{DynamicResource MutedPanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock x:Name="WorkspaceNoticeText"
                                           Text="Add only the blocking rules you need, then launch an application or choose running processes."
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="16,10,16,16">
                        <ProgressBar x:Name="OperationProgress"
                                     Height="3"
                                     Margin="0,0,0,8"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />
                        <Button x:Name="PrimaryActionButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="PrimaryAction_Click"
                                Content="_Start WESP Blocking and launch" />
                        <Button x:Name="CloseSessionButton"
                                Margin="0,7,0,0"
                                Click="CloseSession_Click"
                                Content="_Close blocking session"
                                Visibility="Collapsed" />
                        <Button x:Name="ResetDraftButton"
                                Margin="0,7,0,0"
                                Click="ResetDraft_Click"
                                Content="_Reset draft" />
                        <TextBlock Margin="0,7,0,0"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="This preview covers tested WESP operations only. Applying the active session tags an existing process and children it starts afterward, but not already-running descendants. Closing requests termination only of roots launched by Shackles; selected existing processes survive, and the rules are removed."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="14,10"
                            Background="{DynamicResource MutedPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Style="{StaticResource StepTitleStyle}"
                                               Text="Session activity" />
                                    <Border Margin="9,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BadgeStyle}">
                                        <TextBlock x:Name="ActivityCountText"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Text="0 EVENTS" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="Processes launched or selected in Shackles appear immediately. WESP adds delayed, best-effort block and child-process notifications after enforcement."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="ActivityCaptureStatusText"
                                       Grid.Column="1"
                                       MaxWidth="300"
                                       Margin="18,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="Activity capture starts with the blocking session."
                                       TextAlignment="Right"
                                       TextWrapping="Wrap" />
                            <Button x:Name="SaveActivityLogButton"
                                    Grid.Column="2"
                                    Margin="14,0,0,0"
                                    Padding="10,5"
                                    VerticalAlignment="Center"
                                    Click="SaveActivityLog_Click"
                                    Content="_Save logs…"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Save WESP session activity log" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="SessionActivityList"
                                 Margin="8,6,8,8"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 AutomationProperties.Name="WESP Blocking session activity">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2,2"
                                            Padding="9,7"
                                            Background="{DynamicResource MutedPanelBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="3,0,0,0"
                                            CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="2*" MinWidth="180" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="4*" MinWidth="260" />
                                            </Grid.ColumnDefinitions>
                                            <Border Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <TextBlock Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Status}" />
                                            </Border>
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Process}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Process}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Text="{Binding TimeAndOperation}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding TimeAndOperation}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Target}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Target}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Rule}">
                                                    <TextBlock.Style>
                                                        <Style BasedOn="{StaticResource CaptionStyle}"
                                                               TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rule}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rule}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run FontWeight="SemiBold" Text="Rule  " />
                                                    <Run Text="{Binding Rule, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Margin="18,12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="No session activity yet. Launch an application or choose running processes to begin."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource CaptionStyle}"
                                       TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=SessionActivityList}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ElevationGate"
              Grid.Row="2"
              Visibility="Collapsed"
              AutomationProperties.Name="Administrator access required for WESP Blocking">
            <Border Background="{DynamicResource MutedPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8" />

            <Border MaxWidth="620"
                    MinWidth="480"
                    Margin="32"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="8,8,0,0" />

                    <Grid Grid.Row="1" Margin="30,27,30,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="58"
                                Height="58"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="29">
                            <Viewbox Width="28"
                                     Height="31"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path Data="M 12,1 L 22,5 L 22,12 C 22,19 17.7,24.4 12,27 C 6.3,24.4 2,19 2,12 L 2,5 Z M 12,8 L 12,15 M 12,19 L 12,20"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AccentTextBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2.2" />
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="Administrator access required" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="14"
                                       Text="WESP accepts client connections only from a high-integrity process. This workspace is locked so you do not spend time configuring a session that cannot start."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,9,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="Open an administrator copy directly on WESP Blocking. This Shackles window stays open, along with any work in the other workspaces."
                                       TextWrapping="Wrap" />

                            <Button x:Name="OpenElevatedWespButton"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OpenElevatedWesp_Click"
                                    Content="_Open WESP Blocking as administrator"
                                    AutomationProperties.Name="Open WESP Blocking as administrator"
                                    AutomationProperties.HelpText="Open a separate high-integrity Shackles window directly on WESP Blocking" />
                            <TextBlock x:Name="ElevationLaunchStatusText"
                                       Margin="0,10,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
