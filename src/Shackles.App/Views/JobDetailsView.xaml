<UserControl x:Class="Shackles.App.Views.JobDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Shackles.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16,13"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <TextBlock FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="{Binding DisplayName}" />
                        <Border Margin="9,0,0,0"
                                Style="{StaticResource BadgeStyle}"
                                ToolTip="{Binding OriginDescription}">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding OriginBadge}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="Settings are read back after Apply. Configured does not always mean effective: OS support, nesting, and process state can affect enforcement." />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="Apply spans independent Windows information classes and is not atomic; earlier changes can remain if a later class fails." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Command="{Binding RefreshCommand}" Content="_Refresh job" />
                    <Button Margin="0,0,8,0" Click="LaunchButton_Click" Content="_Launch…" />
                    <Button Click="CloseButton_Click" Content="_Close handle" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    BorderThickness="0"
                    AutomationProperties.Name="Job settings">
            <TabItem Header="Overview">
                <views:OverviewView />
            </TabItem>
            <TabItem Header="Hard limits">
                <views:HardLimitsView />
            </TabItem>
            <TabItem Header="CPU">
                <views:CpuView />
            </TabItem>
            <TabItem Header="Network rate">
                <views:NetworkView />
            </TabItem>
            <TabItem Header="UI">
                <views:UiRestrictionsView />
            </TabItem>
            <TabItem Header="Notifications">
                <views:NotificationsView />
            </TabItem>
            <TabItem Header="Groups &amp; end">
                <views:AdvancedView />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Padding="16,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Editor.ValidationMessage}"
                               Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                               FontWeight="SemiBold"
                               Visibility="{Binding Editor.HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{Binding LastOperationMessage}"
                               Style="{StaticResource CaptionStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button MinWidth="90"
                            Margin="0,0,8,0"
                            Command="{Binding RevertCommand}"
                            Content="_Revert" />
                    <Button MinWidth="100"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ApplyCommand}"
                            Content="_Apply" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
