<UserControl x:Class="Shackles.App.Views.JobDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Shackles.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="DetailsHeader" Style="{StaticResource InstanceHeaderStyle}"
                SizeChanged="DetailsChrome_SizeChanged"
                BorderThickness="0,0,0,1" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayName}"
                                   Text="{Binding DisplayName}" />
                        <Border Margin="9,0,0,0"
                                Style="{StaticResource BadgeStyle}"
                                ToolTip="{Binding OriginDescription}">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding OriginBadge}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="Settings are read back after Apply. Configured does not always mean effective: OS support, nesting, and process state can affect enforcement." />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="Apply spans independent Windows information classes and is not atomic; earlier changes can remain if a later class fails." />
                    <TextBlock Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                <Setter Property="Text" Value="Displayed job state may be outdated. Refresh to verify it." />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSnapshotStale}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasSnapshot}" Value="False">
                                        <Setter Property="Text" Value="Job settings have not been read. Refresh to load them before editing or applying changes." />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Style="{StaticResource CompactButtonStyle}"
                            Command="{Binding RefreshCommand}" Content="_Refresh job" />
                    <Button Margin="0,0,8,0" Style="{StaticResource CompactButtonStyle}"
                            IsEnabled="{Binding CanOperate}"
                            Click="AssignProcessesButton_Click"
                            Content="_Assign running processes…" />
                    <Button Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Padding="9,5"
                            IsEnabled="{Binding CanOperate}" Click="LaunchButton_Click" Content="_Launch…" />
                    <Button Style="{StaticResource CompactButtonStyle}" IsEnabled="{Binding CanOperate}"
                            Click="CloseButton_Click" Content="_Close handle" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="SettingsTabs" Grid.Row="1"
                    MinHeight="200"
                    BorderThickness="0"
                    IsEnabled="{Binding CanEditDraft}"
                    AutomationProperties.Name="Job settings">
            <TabItem Header="Overview">
                <views:OverviewView />
            </TabItem>
            <TabItem Header="Hard limits">
                <views:HardLimitsView />
            </TabItem>
            <TabItem Header="CPU">
                <views:CpuView />
            </TabItem>
            <TabItem Header="Network rate">
                <views:NetworkView />
            </TabItem>
            <TabItem Header="UI">
                <views:UiRestrictionsView />
            </TabItem>
            <TabItem Header="Notifications">
                <views:NotificationsView />
            </TabItem>
            <TabItem Header="Groups &amp; end">
                <views:AdvancedView />
            </TabItem>
        </TabControl>

        <Border x:Name="DetailsFooter" Grid.Row="2"
                SizeChanged="DetailsChrome_SizeChanged"
                Padding="16,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBox Text="{Binding Editor.ValidationMessage, Mode=OneWay}"
                               IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                               Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                               Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="Restriction validation error"
                               Visibility="{Binding Editor.HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBox Text="{Binding LastOperationMessage, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                             Foreground="{DynamicResource MutedTextBrush}"
                             AutomationProperties.Name="Job operation result" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button MinWidth="90"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Command="{Binding RevertCommand}"
                            Content="_Revert" />
                    <Button MinWidth="100"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ApplyCommand}"
                            Content="_Apply" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
