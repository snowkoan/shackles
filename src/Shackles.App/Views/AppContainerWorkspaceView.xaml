<UserControl x:Class="Shackles.App.Views.AppContainerWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="952"
             AutomationProperties.Name="AppContainer sandboxes workspace">
    <UserControl.Resources>
        <Style x:Key="StepTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="OptionCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="11" />
            <Setter Property="Background" Value="{DynamicResource MutedPanelBrush}" />
        </Style>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,12,9" />
        </Style>
        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionTitleStyle}"
                           Text="AppContainer sandboxes" />
                <Button x:Name="ResetDraftButton"
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Click="ResetDraft_Click"
                        Content="_Reset draft" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,5,0,0"
                           Style="{StaticResource CaptionStyle}"
                           Text="Each sandbox receives a distinct AppContainer SID. Launch one or more new processes into the same boundary, or create another sandbox for isolation." />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="670" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,15,16,10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Session sandboxes" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="A card appears only after you start a draft. Active cards represent real Windows profiles." />
                        <Button Margin="0,12,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="NewSandbox_Click"
                                Content="_New sandbox" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="SandboxList"
                                 BorderThickness="0,1,0,1"
                                 Background="Transparent"
                                 SelectionChanged="SandboxList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Session AppContainer sandboxes">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="10,8,10,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="11"
                                            Background="{DynamicResource MutedPanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource BadgeStyle}">
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding StateBadge}" />
                                                </Border>
                                                <TextBlock FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Margin="0,6,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding MemberCountText}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="{Binding PolicySummary}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="{Binding IdentitySummary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptySandboxListHint"
                                    Margin="22"
                                    VerticalAlignment="Center"
                                    TextBlock.TextAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="No session sandboxes" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="New sandbox starts an editable draft. It does not create a Windows profile or launch anything." />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="12"
                            Padding="10"
                            Background="{DynamicResource MutedPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Selecting an active card lets you launch another process with that same sandbox SID and policy."
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="EmptyEditorState"
                    Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel MaxWidth="480"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextBlock.TextAlignment="Center">
                    <TextBlock FontSize="23" FontWeight="SemiBold" Text="Start a sandbox draft" />
                    <TextBlock Margin="0,8,0,17"
                               Style="{StaticResource CaptionStyle}"
                               Text="Choose the boundary and first process. The Windows profile and SID are created only when Create sandbox and launch succeeds." />
                    <Button HorizontalAlignment="Center"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="NewSandbox_Click"
                            Content="_New sandbox" />
                </StackPanel>
            </Border>

            <Grid x:Name="SandboxEditorHost"
                  Grid.Column="2"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorderStyle}" Padding="14,11">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Margin="18,0,0,0"
                                    HorizontalAlignment="Right">
                            <Border HorizontalAlignment="Right"
                                    Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="EditorStateBadgeText"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="DRAFT" />
                            </Border>
                            <TextBlock x:Name="SandboxIdentityText"
                                       Width="300"
                                       Margin="0,5,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       Text="SID allocated on first launch" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="SandboxHeaderNameText"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="Sandbox 1" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="Boundary settings are fixed after creation. Launch settings remain available for additional processes." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.62*" MinWidth="400" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="258" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="0">
                        <ScrollViewer x:Name="SandboxEditorScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="18,16,18,22">
                                <StackPanel x:Name="PolicyControlsPanel">
                                    <TextBlock FontSize="19"
                                               FontWeight="SemiBold"
                                               Text="Configure sandbox" />
                                    <TextBlock Margin="0,4,0,16"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="These settings define the shared security boundary." />

                                    <TextBlock Style="{StaticResource StepTitleStyle}"
                                               Text="1. Identity and policy" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   Text="Sandbox name" />
                                        <TextBox x:Name="SandboxNameTextBox"
                                                 Grid.Column="1"
                                                 MaxLength="128"
                                                 TextChanged="PreviewText_Changed" />
                                    </Grid>
                                    <TextBlock Margin="0,7,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="The profile remains until you close this sandbox or Shackles exits." />

                                    <TextBlock Margin="0,16,0,7"
                                               FontWeight="SemiBold"
                                               Text="Isolation level" />
                                    <UniformGrid Columns="2">
                                        <Border Margin="0,0,5,0"
                                                Style="{StaticResource OptionCardStyle}">
                                            <RadioButton x:Name="StandardIsolationRadio"
                                                         GroupName="IsolationMode"
                                                         IsChecked="True"
                                                         Checked="PreviewOption_Changed"
                                                         Unchecked="PreviewOption_Changed"
                                                         Content="Standard AppContainer" />
                                        </Border>
                                        <Border Margin="5,0,0,0"
                                                Style="{StaticResource OptionCardStyle}">
                                            <RadioButton x:Name="LpacIsolationRadio"
                                                         GroupName="IsolationMode"
                                                         Checked="PreviewOption_Changed"
                                                         Unchecked="PreviewOption_Changed"
                                                         Content="Strict (LPAC)" />
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Margin="0,15,0,7"
                                               FontWeight="SemiBold"
                                               Text="File access mechanism" />
                                    <UniformGrid Columns="2">
                                        <Border Margin="0,0,5,0"
                                                Style="{StaticResource OptionCardStyle}">
                                            <RadioButton x:Name="FileSystemAclRadio"
                                                         GroupName="FileSystemPolicyBackend"
                                                         IsChecked="True"
                                                         Checked="PreviewOption_Changed"
                                                         Unchecked="PreviewOption_Changed"
                                                         Content="Host ACL grants" />
                                        </Border>
                                        <Border Margin="5,0,0,0"
                                                Style="{StaticResource OptionCardStyle}">
                                            <RadioButton x:Name="BrokeredFileSystemRadio"
                                                         GroupName="FileSystemPolicyBackend"
                                                         Checked="PreviewOption_Changed"
                                                         Unchecked="PreviewOption_Changed"
                                                         Content="Brokered File System (experimental)" />
                                        </Border>
                                    </UniformGrid>
                                    <TextBlock x:Name="BfsSupportText"
                                               Margin="0,7,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Margin="0,15,0,4"
                                               FontWeight="SemiBold"
                                               Text="Process behavior" />
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="AllowChildrenCheckBox"
                                                  IsChecked="True"
                                                  Checked="PreviewOption_Changed"
                                                  Unchecked="PreviewOption_Changed"
                                                  Content="Allow launched processes to create children" />
                                        <CheckBox x:Name="MinimalEnvironmentCheckBox"
                                                  Checked="PreviewOption_Changed"
                                                  Unchecked="PreviewOption_Changed"
                                                  Content="Use a minimal environment" />
                                        <CheckBox IsChecked="True"
                                                  IsEnabled="False"
                                                  Content="Do not inherit parent handles" />
                                    </UniformGrid>
                                    <TextBlock Margin="0,7,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="Shackles retains handles only for processes launched directly from this workspace." />
                                </StackPanel>

                                <Separator Margin="0,19,0,15" />
                                <TextBlock Style="{StaticResource StepTitleStyle}"
                                           Text="2. Process to launch" />
                                <TextBlock Margin="0,3,0,11"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="After creation, use this same panel to launch additional processes into the selected sandbox." />
                                <TextBlock Margin="0,0,0,5"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="Executable" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExecutablePathTextBox"
                                             TextChanged="PreviewText_Changed" />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Click="BrowseExecutable_Click"
                                            Content="_Browse…" />
                                </Grid>
                                <TextBlock Margin="0,12,0,5"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="Arguments" />
                                <TextBox x:Name="ArgumentsTextBox"
                                         TextChanged="PreviewText_Changed" />
                                <TextBlock Margin="0,12,0,5"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="Working directory" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WorkingDirectoryTextBox"
                                             TextChanged="PreviewText_Changed" />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Click="BrowseWorkingDirectory_Click"
                                            Content="B_rowse…" />
                                </Grid>
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="Leave blank to inherit Shackles' current working directory." />
                                <CheckBox x:Name="IncludeTargetAccessCheckBox"
                                          Margin="0,10,0,0"
                                          IsChecked="True"
                                          Checked="PreviewOption_Changed"
                                          Unchecked="PreviewOption_Changed"
                                          Content="Automatically make the executable folder available when needed" />

                                <Separator Margin="0,19,0,15" />
                                <TextBlock Style="{StaticResource StepTitleStyle}"
                                           Text="3. Access" />
                                <TextBlock Margin="0,3,0,11"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="File access uses the selected mechanism. Registry grants use temporary host ACL entries. Network and capability selections affect the sandbox token." />

                                <TabControl x:Name="SharedAccessTabs" MinHeight="330">
                                    <TabItem Header="Files &amp; folders">
                                        <StackPanel Margin="12">
                                            <TextBlock x:Name="FileSystemPolicyHeadingText"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="FileSystemPolicyDescriptionText"
                                                       Margin="0,4,0,10"
                                                       Style="{StaticResource CaptionStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="Existing file or folder path" />
                                            <Grid Margin="0,5,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="FileSystemPathTextBox"
                                                         ToolTip="Enter a full path, or choose an existing file or folder" />
                                                <Button Grid.Column="1"
                                                        Margin="7,0,0,0"
                                                        Padding="8,5"
                                                        Click="BrowseFileGrant_Click"
                                                        Content="Choose _file…" />
                                                <Button Grid.Column="2"
                                                        Margin="6,0,0,0"
                                                        Padding="8,5"
                                                        Click="BrowseFolderGrant_Click"
                                                        Content="Choose _folder…" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="FileSystemAccessComboBox"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="Read and run" />
                                                    <ComboBoxItem Content="Read, write, delete" />
                                                </ComboBox>
                                                <Button Grid.Column="1"
                                                        Margin="7,0,0,0"
                                                        Click="AddFileSystemGrant_Click"
                                                        Content="_Add path" />
                                            </Grid>
                                            <TextBlock x:Name="FileSystemPolicyRequirementText"
                                                       Margin="0,6,0,9"
                                                       Style="{StaticResource CaptionStyle}"
                                                       TextWrapping="Wrap" />
                                            <ListBox x:Name="FileGrantList"
                                                     MinHeight="105"
                                                     BorderThickness="1">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="145" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="{Binding Path}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Style="{StaticResource CaptionStyle}"
                                                                           Text="{Binding KindText}" />
                                                            </StackPanel>
                                                            <ComboBox Grid.Column="1"
                                                                      Margin="8,0"
                                                                      SelectedIndex="{Binding AccessIndex}">
                                                                <ComboBoxItem Content="Read and run" />
                                                                <ComboBoxItem Content="Read, write, delete" />
                                                            </ComboBox>
                                                            <Button Grid.Column="2"
                                                                    Padding="7,4"
                                                                    Tag="{Binding}"
                                                                    Click="RemoveFileGrant_Click"
                                                                    Content="Remove" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </TabItem>

                                    <TabItem Header="Registry">
                                        <StackPanel Margin="12">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="Temporary registry ACL grants" />
                                            <TextBlock Margin="0,4,0,10"
                                                       Style="{StaticResource CaptionStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="For a launch, Shackles adds an explicit allow entry for its SID to the existing key. The entry is removed when the final directly tracked process exits and reapplied for a later launch." />
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="Existing registry key path" />
                                            <TextBox x:Name="RegistryKeyTextBox"
                                                     Margin="0,5,0,8"
                                                     ToolTip="For example: HKCU\Software\Contoso" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="RegistryAccessComboBox"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="Read" />
                                                    <ComboBoxItem Content="Read and write" />
                                                </ComboBox>
                                                <ComboBox x:Name="RegistryViewComboBox"
                                                          Grid.Column="1"
                                                          Margin="7,0"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="Automatic view" />
                                                    <ComboBoxItem Content="32-bit view" />
                                                    <ComboBoxItem Content="64-bit view" />
                                                </ComboBox>
                                                <Button Grid.Column="2"
                                                        Click="AddRegistryGrant_Click"
                                                        Content="_Add key" />
                                            </Grid>
                                            <TextBlock Margin="0,6,0,9"
                                                       Style="{StaticResource CaptionStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="Shackles must have permission to change the key's ACL; selecting a registry view does not bypass that requirement." />
                                            <ListBox x:Name="RegistryGrantList"
                                                     MinHeight="105"
                                                     BorderThickness="1">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="135" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="{Binding Path}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Style="{StaticResource CaptionStyle}"
                                                                           Text="Registry key" />
                                                            </StackPanel>
                                                            <ComboBox Grid.Column="1"
                                                                      Margin="8,0,0,0"
                                                                      SelectedIndex="{Binding AccessIndex}">
                                                                <ComboBoxItem Content="Read" />
                                                                <ComboBoxItem Content="Read and write" />
                                                            </ComboBox>
                                                            <ComboBox Grid.Column="2"
                                                                      Margin="7,0"
                                                                      SelectedIndex="{Binding ViewIndex}">
                                                                <ComboBoxItem Content="Automatic view" />
                                                                <ComboBoxItem Content="32-bit view" />
                                                                <ComboBoxItem Content="64-bit view" />
                                                            </ComboBox>
                                                            <Button Grid.Column="3"
                                                                    Padding="7,4"
                                                                    Tag="{Binding}"
                                                                    Click="RemoveRegistryGrant_Click"
                                                                    Content="Remove" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </TabItem>

                                    <TabItem Header="Network">
                                        <StackPanel Margin="13">
                                            <TextBlock Margin="0,0,0,8"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="Connectivity is denied unless selected here. Using your identity on the network is a separate permission." />
                                            <TextBlock Margin="0,0,0,3"
                                                       FontWeight="SemiBold"
                                                       Text="Connectivity" />
                                            <CheckBox x:Name="InternetClientCheckBox"
                                                      Checked="PreviewOption_Changed"
                                                      Unchecked="PreviewOption_Changed"
                                                      Content="Internet client — outbound connections" />
                                            <CheckBox x:Name="InternetServerCheckBox"
                                                      Checked="PreviewOption_Changed"
                                                      Unchecked="PreviewOption_Changed"
                                                      Content="Internet client/server — listeners and outbound connections" />
                                            <CheckBox x:Name="PrivateNetworkCheckBox"
                                                      Checked="PreviewOption_Changed"
                                                      Unchecked="PreviewOption_Changed"
                                                      Content="Private networks — local network client/server" />
                                            <Separator Margin="0,9,0,8" />
                                            <TextBlock Margin="0,0,0,3"
                                                       FontWeight="SemiBold"
                                                       Text="Network identity" />
                                            <CheckBox x:Name="NetworkCredentialsCheckBox"
                                                      Checked="PreviewOption_Changed"
                                                      Unchecked="PreviewOption_Changed"
                                                      Content="Use my Windows credentials for network files and resources" />
                                            <TextBlock Margin="20,2,0,0"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="Sensitive permission: allows sandbox members to authenticate as you and open compatible network paths such as SMB shares. It does not grant network connectivity by itself." />
                                        </StackPanel>
                                    </TabItem>

                                    <TabItem Header="Capabilities">
                                        <StackPanel Margin="13">
                                            <TextBlock Margin="0,0,0,7"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="Curated capability SIDs shared by sandbox members." />
                                            <UniformGrid Columns="2">
                                                <CheckBox x:Name="PicturesLibraryCheckBox"
                                                          Checked="PreviewOption_Changed"
                                                          Unchecked="PreviewOption_Changed"
                                                          Content="Pictures library" />
                                                <CheckBox x:Name="VideosLibraryCheckBox"
                                                          Checked="PreviewOption_Changed"
                                                          Unchecked="PreviewOption_Changed"
                                                          Content="Videos library" />
                                                <CheckBox x:Name="MusicLibraryCheckBox"
                                                          Checked="PreviewOption_Changed"
                                                          Unchecked="PreviewOption_Changed"
                                                          Content="Music library" />
                                                <CheckBox x:Name="RemovableStorageCheckBox"
                                                          Checked="PreviewOption_Changed"
                                                          Unchecked="PreviewOption_Changed"
                                                          Content="Removable storage" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="SandboxSummaryScrollViewer"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,15,16,10">
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="Effective sandbox" />
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource SummaryLabelStyle}"
                                                   Text="Name" />
                                        <TextBlock x:Name="NameSummaryText"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="1"
                                                   Style="{StaticResource SummaryLabelStyle}"
                                                   Text="Lifetime" />
                                        <TextBlock x:Name="LifetimeSummaryText"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="2"
                                                   Style="{StaticResource SummaryLabelStyle}"
                                                   Text="Isolation" />
                                        <TextBlock x:Name="IsolationSummaryText"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="3"
                                                   Style="{StaticResource SummaryLabelStyle}"
                                                   Text="Children" />
                                        <TextBlock x:Name="ChildrenSummaryText"
                                                   Grid.Row="3"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="4"
                                                   Style="{StaticResource SummaryLabelStyle}"
                                                   Text="Network" />
                                        <TextBlock x:Name="NetworkSummaryText"
                                                   Grid.Row="4"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="5"
                                                   Style="{StaticResource SummaryLabelStyle}"
                                                   Text="Credentials" />
                                        <TextBlock x:Name="CredentialsSummaryText"
                                                   Grid.Row="5"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="6"
                                                   Style="{StaticResource SummaryLabelStyle}"
                                                   Text="Capabilities" />
                                        <TextBlock x:Name="CapabilitiesSummaryText"
                                                   Grid.Row="6"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="7"
                                                   Style="{StaticResource SummaryLabelStyle}"
                                                   Text="File access" />
                                        <TextBlock x:Name="HostChangesSummaryText"
                                                   Grid.Row="7"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SummaryValueStyle}" />
                                    </Grid>

                                    <Separator Margin="0,6,0,12" />
                                    <DockPanel>
                                        <TextBlock x:Name="MemberCountSummaryText"
                                                   DockPanel.Dock="Right"
                                                   FontWeight="SemiBold"
                                                   Text="0" />
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Tracked launches" />
                                    </DockPanel>
                                    <ListBox x:Name="MemberProcessList"
                                             MinHeight="54"
                                             MaxHeight="120"
                                             Margin="0,7,0,0"
                                             BorderThickness="1" />

                                    <Separator Margin="0,13,0,12" />
                                    <TextBlock FontWeight="SemiBold" Text="Cleanup" />
                                    <TextBlock x:Name="CleanupSummaryText"
                                               Margin="0,5,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap" />

                                    <Border x:Name="WorkspaceNotice"
                                            Margin="0,13,0,0"
                                            Padding="9"
                                            Background="{DynamicResource MutedPanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="WorkspaceNoticeText"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1" Margin="16,10,16,16">
                                <ProgressBar x:Name="OperationProgress"
                                             Height="3"
                                             Margin="0,0,0,8"
                                             IsIndeterminate="True"
                                             Visibility="Collapsed" />
                                <Button x:Name="CreateAndLaunchButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="CreateAndLaunch_Click"
                                        Content="_Create sandbox and launch" />
                                <Button x:Name="CloseSandboxButton"
                                        Margin="0,7,0,0"
                                        Click="CloseSandbox_Click"
                                        Content="_Discard draft" />
                                <TextBlock Margin="0,7,0,0"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="Shackles retains direct process handles so launches can be listed and closed." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
