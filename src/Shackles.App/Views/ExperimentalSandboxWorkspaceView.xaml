<UserControl x:Class="Shackles.App.Views.ExperimentalSandboxWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="952"
             AutomationProperties.Name="Experimental process sandboxes workspace">
    <UserControl.Resources>
        <Style x:Key="StepTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="OptionCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="11" />
            <Setter Property="Background" Value="{DynamicResource MutedPanelBrush}" />
        </Style>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,12,9" />
        </Style>
        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Experimental process sandboxes" />
                    <TextBlock MaxWidth="880" Margin="0,5,0,0" HorizontalAlignment="Left"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Text="Each card keeps one in-memory identity and policy. Every launch uses the experimental Windows API and gets a separate OS-managed sandbox." />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Padding="10,5" Click="RefreshSupport_Click" Content="Refresh _support" />
                    <Button x:Name="ResetDraftButton" Padding="10,5" Click="ResetDraft_Click" Content="_Reset draft" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="670" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,15,16,10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Session sandboxes" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                   Text="Drafts are local UI state. Active cards share one identity across their launches." />
                        <Button x:Name="NewSandboxButton" Margin="0,12,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="NewSandbox_Click" Content="_New sandbox" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="SandboxList" BorderThickness="0,1,0,1" Background="Transparent"
                                 SelectionChanged="SandboxList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Session experimental sandboxes">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="10,8,10,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="11" Background="{DynamicResource MutedPanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource BadgeStyle}">
                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding StateBadge}" />
                                                </Border>
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding MemberCountText}" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}"
                                                       Text="{Binding PolicySummary}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}"
                                                       Text="{Binding IdentitySummary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptySandboxListHint" MaxWidth="205" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Style="{StaticResource CaptionStyle}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Choose New sandbox to begin a policy draft." />
                    </Grid>

                    <Border Grid.Row="2" Margin="12" Padding="10" Background="{DynamicResource MutedPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <TextBlock x:Name="SupportStateText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SupportDetailText" Margin="0,4,0,0"
                                       Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="FeatureStateText" Margin="0,5,0,0"
                                       Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid x:Name="EmptyEditorState">
                    <StackPanel MaxWidth="470" HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextBlock.TextAlignment="Center">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Create a process sandbox draft" />
                        <TextBlock Margin="0,8,0,16" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                   Text="Choose isolation, native path policy, networking, and UI restrictions before the first launch." />
                        <Button x:Name="EmptyNewSandboxButton" HorizontalAlignment="Center"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="NewSandbox_Click" Content="_New sandbox" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="SandboxEditorHost" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="420" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="3*" MinWidth="250" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,15,16,16">
                                <StackPanel x:Name="PolicyEditor">
                                    <TextBlock Style="{StaticResource StepTitleStyle}" Text="1  Identity and isolation" />
                                    <TextBlock Margin="0,5,0,10" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                               Text="The identity is stable for this card. Policy is frozen after the first successful launch, apart from visible launch-path grants that can grow." />
                                    <TextBlock Margin="0,0,0,3" FontWeight="SemiBold" Text="Sandbox name" />
                                    <TextBox x:Name="SandboxNameTextBox" TextChanged="PreviewText_Changed" />
                                    <Border Margin="0,10,0,0" Style="{StaticResource OptionCardStyle}">
                                        <StackPanel>
                                            <CheckBox x:Name="UseAppContainerCheckBox" FontWeight="SemiBold"
                                                      Checked="AppContainerOption_Changed" Unchecked="AppContainerOption_Changed"
                                                      Content="Use AppContainer isolation" />
                                            <TextBlock Margin="20,3,0,8" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                                       Text="Required for native filesystem rules, capabilities, network policy, and least-privilege mode." />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="20,0,12,0" VerticalAlignment="Center" Text="Integrity" />
                                                <ComboBox x:Name="IntegrityComboBox" Grid.Column="1"
                                                          SelectionChanged="PreviewSelection_Changed">
                                                    <ComboBoxItem Content="System default" />
                                                    <ComboBoxItem Content="Inherit" />
                                                    <ComboBoxItem Content="Untrusted" />
                                                    <ComboBoxItem Content="Low" />
                                                    <ComboBoxItem Content="Medium" />
                                                    <ComboBoxItem Content="High" />
                                                </ComboBox>
                                            </Grid>
                                            <CheckBox x:Name="LeastPrivilegeCheckBox" Margin="20,8,0,0"
                                                      Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                      Content="Strip token privileges (least privilege)" />
                                        </StackPanel>
                                    </Border>
                                    <Separator Margin="0,16,0,14" />
                                    <TextBlock Style="{StaticResource StepTitleStyle}" Text="2  Sandbox policy" />
                                    <TabControl Margin="0,10,0,0">
                                        <TabItem Header="Files &amp; folders">
                                            <StackPanel x:Name="FileSystemPolicyPanel" Margin="13">
                                                <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                                           Text="These are native SBOX/BFS rules. They do not change directory ACLs and disappear with the OS sandbox policy." />
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="FileSystemPathTextBox" VerticalContentAlignment="Center" />
                                                    <Button Grid.Column="1" Margin="7,0,0,0" Padding="9,5"
                                                            Click="BrowseFolderRule_Click" Content="Browse…" />
                                                </Grid>
                                                <Grid Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="FileSystemAccessComboBox" SelectedIndex="0">
                                                        <ComboBoxItem Content="Read and write" />
                                                        <ComboBoxItem Content="Read only" />
                                                        <ComboBoxItem Content="Deny" />
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Margin="7,0,0,0" Padding="9,5"
                                                            Click="AddFileSystemRule_Click" Content="Add rule" />
                                                </Grid>
                                                <TextBlock x:Name="DenySupportText" Margin="0,6,0,0"
                                                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                                <ListBox x:Name="FileSystemRuleList" MinHeight="70" MaxHeight="190"
                                                         Margin="0,10,0,0" BorderThickness="1">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="7,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="145" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Path}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                                                               Text="Directory and descendants" />
                                                                </StackPanel>
                                                                <ComboBox Grid.Column="1" Margin="8,0,0,0"
                                                                          SelectedIndex="{Binding AccessIndex}">
                                                                    <ComboBoxItem Content="Read and write" />
                                                                    <ComboBoxItem Content="Read only" />
                                                                    <ComboBoxItem Content="Deny" />
                                                                </ComboBox>
                                                                <Button Grid.Column="2" Margin="7,0,0,0" Padding="7,4"
                                                                        Tag="{Binding}" Click="RemoveFileSystemRule_Click"
                                                                        Content="Remove" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </TabItem>

                                        <TabItem Header="Network &amp; capabilities">
                                            <StackPanel Margin="13">
                                                <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                                           Text="Network policy and capabilities are separate gates. Direct access still needs an appropriate network capability." />
                                                <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" Text="Traffic policy" />
                                                <ComboBox x:Name="NetworkModeComboBox" SelectionChanged="NetworkMode_Changed">
                                                    <ComboBoxItem Content="Block direct network traffic" />
                                                    <ComboBoxItem Content="Allow direct network traffic" />
                                                    <ComboBoxItem Content="Route through a proxy" />
                                                </ComboBox>
                                                <TextBlock Margin="0,8,0,3" Text="Proxy URL" />
                                                <TextBox x:Name="ProxyUrlTextBox" TextChanged="PreviewText_Changed" />
                                                <Separator Margin="0,11,0,10" />
                                                <TextBlock FontWeight="SemiBold" Text="Named capabilities" />
                                                <UniformGrid Margin="0,6,0,0" Columns="2">
                                                    <CheckBox x:Name="InternetClientCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Internet client" />
                                                    <CheckBox x:Name="InternetClientServerCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Internet client/server" />
                                                    <CheckBox x:Name="PrivateNetworkCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Private networks" />
                                                    <CheckBox x:Name="RegistryReadCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Read HKLM registry hives" />
                                                </UniformGrid>
                                                <TextBlock Margin="0,9,0,3" Text="Additional capability names" />
                                                <TextBox x:Name="CustomCapabilitiesTextBox" MinHeight="50" AcceptsReturn="True"
                                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                         TextChanged="PreviewText_Changed" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}"
                                                           Text="Enter one capability per line. Unknown names fail the entire launch." />
                                            </StackPanel>
                                        </TabItem>

                                        <TabItem Header="UI restrictions">
                                            <StackPanel Margin="13">
                                                <CheckBox x:Name="DisallowWin32kCheckBox" FontWeight="SemiBold"
                                                          Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                          Content="Disable all Win32k / GUI system calls" />
                                                <TextBlock Margin="20,3,0,9" Style="{StaticResource CaptionStyle}"
                                                           TextWrapping="Wrap"
                                                           Text="Headless workloads only. Desktop applications commonly fail during initialization when this is enabled." />
                                                <UniformGrid Columns="2">
                                                    <CheckBox x:Name="BlockExternalHandlesCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="External USER handles" />
                                                    <CheckBox x:Name="BlockGlobalAtomsCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Global atoms" />
                                                    <CheckBox x:Name="BlockClipboardReadCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Clipboard reads" />
                                                    <CheckBox x:Name="BlockClipboardWriteCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Clipboard writes" />
                                                    <CheckBox x:Name="BlockSystemParametersCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="System parameters" />
                                                    <CheckBox x:Name="BlockDisplaySettingsCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Display settings" />
                                                    <CheckBox x:Name="BlockDesktopCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Desktop creation/switching" />
                                                    <CheckBox x:Name="BlockExitWindowsCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Logoff and shutdown" />
                                                    <CheckBox x:Name="BlockImeCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Input method editor modules" />
                                                    <CheckBox x:Name="BlockInputInjectionCheckBox"
                                                              Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                                              Content="Synthetic input injection" />
                                                </UniformGrid>
                                            </StackPanel>
                                        </TabItem>
                                    </TabControl>
                                </StackPanel>

                                <Separator Margin="0,16,0,14" />
                                <TextBlock Style="{StaticResource StepTitleStyle}" Text="3  Launch a process" />
                                <TextBlock Margin="0,5,0,10" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                           Text="Target and working-directory access becomes visible native policy on this card; it never changes host ACLs." />
                                <TextBlock Margin="0,0,0,3" FontWeight="SemiBold" Text="Executable" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExecutablePathTextBox" TextChanged="PreviewText_Changed" />
                                    <Button Grid.Column="1" Margin="7,0,0,0" Padding="9,5"
                                            Click="BrowseExecutable_Click" Content="Browse…" />
                                </Grid>
                                <TextBlock Margin="0,8,0,3" Text="Arguments" />
                                <TextBox x:Name="ArgumentsTextBox" TextChanged="PreviewText_Changed" />
                                <TextBlock Margin="0,8,0,3" Text="Working directory" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WorkingDirectoryTextBox" TextChanged="PreviewText_Changed" />
                                    <Button Grid.Column="1" Margin="7,0,0,0" Padding="9,5"
                                            Click="BrowseWorkingDirectory_Click" Content="Browse…" />
                                </Grid>
                                <CheckBox x:Name="IncludeTargetAccessCheckBox" Margin="0,9,0,0"
                                          Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                          Content="Add the executable directory as read-only policy" />
                                <CheckBox x:Name="IncludeWorkingDirectoryWriteAccessCheckBox"
                                          Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"
                                          Content="Add an explicit working directory as read/write policy" />
                                <TextBlock Margin="0,9,0,3" Text="Environment" />
                                <ComboBox x:Name="EnvironmentModeComboBox" SelectionChanged="PreviewSelection_Changed">
                                    <ComboBoxItem Content="Inherit Shackles environment" />
                                    <ComboBoxItem Content="Clean user environment" />
                                </ComboBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,15,16,10">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Effective sandbox" />
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="Name" />
                                        <TextBlock x:Name="NameSummaryText" Grid.Column="1" Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource SummaryLabelStyle}" Text="Identity" />
                                        <TextBlock x:Name="IdentitySummaryText" Grid.Row="1" Grid.Column="1" Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource SummaryLabelStyle}" Text="Isolation" />
                                        <TextBlock x:Name="IsolationSummaryText" Grid.Row="2" Grid.Column="1" Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource SummaryLabelStyle}" Text="Integrity" />
                                        <TextBlock x:Name="IntegritySummaryText" Grid.Row="3" Grid.Column="1" Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="4" Style="{StaticResource SummaryLabelStyle}" Text="Filesystem" />
                                        <TextBlock x:Name="FileSystemSummaryText" Grid.Row="4" Grid.Column="1" Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="5" Style="{StaticResource SummaryLabelStyle}" Text="Network" />
                                        <TextBlock x:Name="NetworkSummaryText" Grid.Row="5" Grid.Column="1" Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="6" Style="{StaticResource SummaryLabelStyle}" Text="UI" />
                                        <TextBlock x:Name="UiSummaryText" Grid.Row="6" Grid.Column="1" Style="{StaticResource SummaryValueStyle}" />
                                        <TextBlock Grid.Row="7" Style="{StaticResource SummaryLabelStyle}" Text="Host changes" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource SummaryValueStyle}"
                                                   Text="None — native policy only" />
                                    </Grid>

                                    <Separator Margin="0,6,0,12" />
                                    <DockPanel>
                                        <TextBlock x:Name="MemberCountSummaryText" DockPanel.Dock="Right"
                                                   FontWeight="SemiBold" Text="0" />
                                        <TextBlock FontWeight="SemiBold" Text="Tracked launches" />
                                    </DockPanel>
                                    <ListBox x:Name="MemberProcessList" MinHeight="54" MaxHeight="120"
                                             Margin="0,7,0,0" BorderThickness="1" />
                                    <Separator Margin="0,13,0,12" />
                                    <TextBlock FontWeight="SemiBold" Text="Lifetime" />
                                    <TextBlock x:Name="LifetimeSummaryText" Margin="0,5,0,0"
                                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <Border x:Name="WorkspaceNotice" Margin="0,13,0,0" Padding="9"
                                            Background="{DynamicResource MutedPanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Visibility="Collapsed">
                                        <TextBlock x:Name="WorkspaceNoticeText" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1" Margin="16,10,16,16">
                                <ProgressBar x:Name="OperationProgress" Height="3" Margin="0,0,0,8"
                                             IsIndeterminate="True" Visibility="Collapsed" />
                                <Button x:Name="CreateAndLaunchButton" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="CreateAndLaunch_Click" Content="_Create sandbox and launch" />
                                <Button x:Name="CloseSandboxButton" Margin="0,7,0,0"
                                        Click="CloseSandbox_Click" Content="_Discard draft" />
                                <TextBlock Margin="0,7,0,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                           Text="Closing terminates directly launched roots and removes the Windows profile. The API does not expose its internal Job handle." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
