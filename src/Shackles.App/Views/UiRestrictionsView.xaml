<UserControl x:Class="Shackles.App.Views.UiRestrictionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Margin="0,0,0,14"
                    Padding="11"
                    CornerRadius="6"
                    Background="{DynamicResource MutedPanelBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource BadgeStyle}">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="{Binding Capabilities.UiRestrictions.BadgeText}" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Hard UI restrictions" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="{Binding Capabilities.UiRestrictions.Reason}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel IsEnabled="{Binding Capabilities.UiRestrictions.CanSet}">
                <GroupBox Header="Disallow job processes from using" Style="{StaticResource EditorGroupStyle}">
                    <UniformGrid Columns="2">
                        <CheckBox IsChecked="{Binding Editor.RestrictHandles}"
                                  Content="USER handles owned outside the job" />
                        <CheckBox IsChecked="{Binding Editor.RestrictReadClipboard}"
                                  Content="Reading the clipboard" />
                        <CheckBox IsChecked="{Binding Editor.RestrictWriteClipboard}"
                                  Content="Writing the clipboard" />
                        <CheckBox IsChecked="{Binding Editor.RestrictSystemParameters}"
                                  Content="Changing system parameters" />
                        <CheckBox IsChecked="{Binding Editor.RestrictDisplaySettings}"
                                  Content="Changing display settings" />
                        <CheckBox IsChecked="{Binding Editor.RestrictGlobalAtoms}"
                                  Content="Accessing global atoms" />
                        <CheckBox IsChecked="{Binding Editor.RestrictDesktops}"
                                  Content="Creating or switching desktops" />
                        <CheckBox IsChecked="{Binding Editor.RestrictExitWindows}"
                                  Content="Logging off Windows" />
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="Advanced SDK flags" Style="{StaticResource EditorGroupStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,7"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="These names follow the current Windows SDK. Their behavior and availability can vary by OS build." />
                        <CheckBox IsChecked="{Binding Editor.RestrictIme}"
                                  Content="JOB_OBJECT_UILIMIT_IME (IME access)" />
                        <CheckBox IsChecked="{Binding Editor.RestrictInjection}"
                                  Content="JOB_OBJECT_UILIMIT_INJECTION (input injection)" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
