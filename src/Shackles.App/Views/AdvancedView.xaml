<UserControl x:Class="Shackles.App.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <GroupBox Header="Processor group affinities"
                      Style="{StaticResource EditorGroupStyle}"
                      IsEnabled="{Binding Capabilities.ProcessorGroups.CanSet}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Left" Style="{StaticResource BadgeStyle}">
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="{Binding Capabilities.ProcessorGroups.BadgeText}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="{Binding Capabilities.ProcessorGroups.Reason}" />
                    </DockPanel>
                    <Label Target="{Binding ElementName=ProcessorGroupsBox}"
                           Padding="0,0,0,5"
                           FontWeight="SemiBold"
                           Content="_Group:mask pairs" />
                    <TextBox x:Name="ProcessorGroupsBox"
                             Text="{Binding Editor.ProcessorGroups, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.HelpText="Comma-separated processor group and affinity mask pairs." />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="Comma-separated, for example 0:0xFF, 1:0x3. Leave blank to preserve the current groups; Windows does not accept an empty group array." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="End-of-job-time action"
                      Style="{StaticResource EditorGroupStyle}"
                      IsEnabled="{Binding Capabilities.EndOfJobAction.CanSet}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Left" Style="{StaticResource BadgeStyle}">
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="{Binding Capabilities.EndOfJobAction.BadgeText}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="{Binding Capabilities.EndOfJobAction.Reason}" />
                    </DockPanel>
                    <Border Margin="0,0,0,10"
                            Padding="9"
                            CornerRadius="5"
                            Background="{DynamicResource MutedPanelBrush}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource BadgeStyle}">
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="{Binding NotificationDeliveryBadge}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="{Binding NotificationDeliveryDescription}" />
                        </DockPanel>
                    </Border>
                    <ComboBox Width="280"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding Editor.EndActionChoices}"
                              SelectedItem="{Binding Editor.EndAction}" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="TerminateAtEndOfJob enforces the per-job time limit. PostNotification is offered only when this Shackles handle owns and consumes a live completion port." />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
