<UserControl x:Class="Shackles.App.Views.HardLimitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Margin="0,0,0,14"
                    Padding="11"
                    CornerRadius="6"
                    Background="{DynamicResource MutedPanelBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource BadgeStyle}">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="{Binding Capabilities.ExtendedLimits.BadgeText}" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Hard limits and lifecycle policy" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="{Binding Capabilities.ExtendedLimits.Reason}" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="Time limits can terminate a process or the job's members, depending on the limit and end action. Memory and working-set limits can make allocations fail." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel IsEnabled="{Binding Capabilities.ExtendedLimits.CanSet}">
                <GroupBox Header="Lifecycle and breakaway" Style="{StaticResource EditorGroupStyle}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Editor.KillOnJobClose}"
                                  Content="Terminate all processes when the last job handle closes" />
                        <CheckBox IsChecked="{Binding Editor.DieOnUnhandledException}"
                                  Content="Terminate a process after an unhandled exception" />
                        <CheckBox IsChecked="{Binding Editor.BreakawayAllowed}"
                                  Content="Allow explicit child-process breakaway" />
                        <CheckBox IsChecked="{Binding Editor.SilentBreakawayAllowed}"
                                  Content="Allow child processes to break away silently" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Process and time limits" Style="{StaticResource EditorGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0"
                                  IsChecked="{Binding Editor.ActiveProcessLimitEnabled}"
                                  Content="Active process limit" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="8,3"
                                 IsEnabled="{Binding Editor.ActiveProcessLimitEnabled}"
                                 Text="{Binding Editor.ActiveProcessLimit, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="processes" />

                        <CheckBox Grid.Row="1"
                                  IsChecked="{Binding Editor.PerProcessTimeEnabled}"
                                  Content="Per-process user time" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="8,3"
                                 IsEnabled="{Binding Editor.PerProcessTimeEnabled}"
                                 Text="{Binding Editor.PerProcessTimeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="seconds" />

                        <CheckBox Grid.Row="2"
                                  IsChecked="{Binding Editor.PerJobTimeEnabled}"
                                  Content="Per-job user time" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="8,3"
                                 IsEnabled="{Binding Editor.PerJobTimeEnabled}"
                                 Text="{Binding Editor.PerJobTimeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="seconds" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Memory and working set" Style="{StaticResource EditorGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox IsChecked="{Binding Editor.WorkingSetEnabled}" Content="Working set range" />
                        <TextBox Grid.Column="1"
                                 Margin="8,3"
                                 IsEnabled="{Binding Editor.WorkingSetEnabled}"
                                 Text="{Binding Editor.MinimumWorkingSetMb, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Minimum MiB" />
                        <TextBox Grid.Column="2"
                                 Margin="8,3"
                                 IsEnabled="{Binding Editor.WorkingSetEnabled}"
                                 Text="{Binding Editor.MaximumWorkingSetMb, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Maximum MiB" />
                        <TextBlock Grid.Column="3"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="min / max MiB" />

                        <CheckBox Grid.Row="1"
                                  IsChecked="{Binding Editor.ProcessMemoryEnabled}"
                                  Content="Per-process memory" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="8,3"
                                 IsEnabled="{Binding Editor.ProcessMemoryEnabled}"
                                 Text="{Binding Editor.ProcessMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="MiB" />

                        <CheckBox Grid.Row="2"
                                  IsChecked="{Binding Editor.JobMemoryEnabled}"
                                  Content="Job memory" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="8,3"
                                 IsEnabled="{Binding Editor.JobMemoryEnabled}"
                                 Text="{Binding Editor.JobMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="3"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="MiB" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Scheduling and affinity" Style="{StaticResource EditorGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox IsChecked="{Binding Editor.AffinityEnabled}" Content="Job affinity mask" />
                        <TextBox Grid.Column="1"
                                 Margin="8,3"
                                 IsEnabled="{Binding Editor.AffinityEnabled}"
                                 Text="{Binding Editor.AffinityMask, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="decimal or 0x hex" />

                        <CheckBox Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="8,3"
                                  IsEnabled="{Binding Editor.AffinityEnabled}"
                                  IsChecked="{Binding Editor.SubsetAffinityAllowed}"
                                  Content="Allow process subset affinity" />

                        <CheckBox Grid.Row="2"
                                  IsChecked="{Binding Editor.PriorityClassEnabled}"
                                  Content="Priority class" />
                        <ComboBox Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="8,3"
                                  IsEnabled="{Binding Editor.PriorityClassEnabled}"
                                  ItemsSource="{Binding Editor.PriorityChoices}"
                                  SelectedItem="{Binding Editor.PriorityClass}" />

                        <CheckBox Grid.Row="3"
                                  IsChecked="{Binding Editor.SchedulingClassEnabled}"
                                  Content="Scheduling class" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="8,3"
                                 IsEnabled="{Binding Editor.SchedulingClassEnabled}"
                                 Text="{Binding Editor.SchedulingClass, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="2"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="0–9" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
